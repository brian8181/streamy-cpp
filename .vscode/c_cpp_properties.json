{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${default}"
            ],
            "windowsSdkVersion": "10.0.26100.0",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "defines": [
                "CYGWIN=TRUE"
            ]
        },
        {
            "name": "Cygwin",
            "includePath": [
                "C:/cygwin64/usr/include",
                "C:/cygwin64/usr/local/include"
            ],
            "windowsSdkVersion": "10.0.26100.0",
            "compilerPath": "C:/cygwin64/bin/g++.exe",
            "intelliSenseMode": "windows-gcc-x64",
            "defines": [
                "CYGWIN=1"
            ],
            "cStandard": "c17",
            "cppStandard": "c++23",
            "browse": {
                "path": [
                    "C:/cygwin64/usr/include",
                    "C:/cygwin64/usr/local/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            },
            "compilerPathInCppPropertiesJson": "C:/cygwin64/bin/g++.exe",
            "mergeConfigurations": true,
            "recursiveIncludes": {}
        }
    ],
    "version": 4
}